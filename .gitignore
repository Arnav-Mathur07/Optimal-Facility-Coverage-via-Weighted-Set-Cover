# ==============================================================================
# OPTIVEX / DAA PBL .gitignore
# Production-ready exclusion list for Python, Streamlit, Docker, and IDEs
# ==============================================================================

# --- Python Bytecode & Compilation Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# --- Virtual Environments (NEVER commit virtual environments) ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
python/

# --- Testing & Quality Assurance ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Streamlit Runtime & Secrets ---
# NEVER commit secrets or credentials!
.streamlit/secrets.toml
.streamlit/cache/

# --- Chrome / Playwright Automated Capture Temporary Data ---
shots/chrome_profile/
*.log
playwright-report/
test-results/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Temporary / Scratch Files ---
*.tmp
*.bak
*.swp
*.orig
scratch/
tmp/

# --- Viva & Examination Cheat Sheets (Keep local only, do not push to public repo) ---
*viva*
*VIVA*
*Viva*
viva_questions*
VIVA_QUESTIONS_AND_ANSWERS.md

